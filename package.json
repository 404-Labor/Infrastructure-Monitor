{
  "name": "watchdog",
  "version": "1.0.0",
  "description": "Open-source Web-Monitoring-System mit Browser-SDK und selbst hostbarem Fastify-Server.",
  "private": true,
  "license": "MIT",
  "author": "Steffen Bahrmann",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "keywords": [
    "watchdog",
    "monitoring",
    "performance",
    "error-tracking",
    "web-vitals",
    "self-hosted",
    "gdpr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/404-Labor/WatchDog"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "clean": "pnpm -r clean",
    "dev:server": "pnpm --filter @404-labor/watchdog-server dev"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/node": "^24.10.1",
    "eslint": "^10.4.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "rollup": "^4.53.3",
    "tslib": "^2.8.1",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
