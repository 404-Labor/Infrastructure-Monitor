{
  "name": "@404-labor/watchdog-server",
  "version": "1.0.0",
  "description": "Self-hostbarer WatchDog Fastify-Server fuer Event-Ingestion und Dashboard-APIs.",
  "license": "MIT",
  "author": "Steffen Bahrmann",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && cp -R src/db/migrations dist/db/migrations",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "better-sqlite3": "^12.5.0",
    "enquirer": "^2.4.1",
    "fastify": "^5.6.2",
    "nanoid": "^5.1.6",
    "pino": "^10.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.21.0"
  }
}
